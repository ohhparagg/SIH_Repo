# CRAFTORA Environment Variables Example
# Copy this file to .env and fill in your credentials

# ==============================================================================
# 1. REAL EMAIL OTP AUTHENTICATION (SMTP)
# ==============================================================================
# Configure standard SMTP provider (e.g. Gmail, Resend, SendGrid, Brevo, AWS SES)
# If empty, OTP codes will be securely generated, hashed, and logged to console for local testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=auth@craftora.in

# ==============================================================================
# 2. FASTAPI & SERVER CONFIGURATION
# ==============================================================================
PORT=3456
FASTAPI_PORT=8000
ENVIRONMENT=production

# ==============================================================================
# 3. AI / VISION SERVICES (OPTIONAL EXTERNAL)
# ==============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=

# ==============================================================================
# 4. FIREBASE CONFIGURATION
# ==============================================================================
FIREBASE_PROJECT_ID=sihdatabaase
FIREBASE_STORAGE_BUCKET=sihdatabaase.firebasestorage.app
